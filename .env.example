# Example environment variables for local development
# Copy this file to ".env" and fill values before running locally.

# Base URL of your Laravel service (Railway). Must include /api/instagram
LARAVEL_BASE_URL=https://wappy.up.railway.app/api/instagram

# Optional: residential proxy for Instagram (format http://user:pass@host:port)
IG_PROXY=

# Optional: port to run the Flask app locally
PORT=5000

# Direct poll seconds (frequency to check DMs)
DIRECT_POLL_SECONDS=20

# How often to poll comments (in cycles)
COMMENTS_POLL_EVERY_CYCLES=3
